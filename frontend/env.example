# Verificarro frontend env vars
# Copia a .env.local para development:  cp .env.example .env.local

# Backend API base URL
# Dev local: vacío para usar el proxy Vite (vite.config.js → localhost:3009)
# Prod build: https://verificarro-api.onrender.com
VITE_API_BASE=

# Vercel Analytics — auto-detectado en deploys de Vercel, no necesita
# config explícita. En dev local sin Vercel no se reporta nada.
# VITE_VERCEL_ANALYTICS_ID=

# Sentry frontend (opcional, agregar si activamos)
# VITE_SENTRY_DSN=
