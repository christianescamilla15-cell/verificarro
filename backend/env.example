# Verificarro backend env vars

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_VISION_MODEL=claude-sonnet-4-6

# --- Server ---
PORT=3009
ENV=development
CORS_ORIGINS=http://localhost:5173

# --- Scraping ---
PLAYWRIGHT_HEADLESS=true
SCRAPE_TIMEOUT_MS=30000
REPUVE_RATE_LIMIT_PER_SEC=1

# --- Database ---
# Dev local Windows: SQLite via aiosqlite (file en backend/)
DATABASE_URL=sqlite+aiosqlite:///./verificarro.db
# Render production: postgresql+asyncpg://user:pass@host:5432/dbname
# REDIS_URL=redis://localhost:6379/0  (futuro, no usado todavía)

# --- Mercado Pago ---
MP_ACCESS_TOKEN=TEST-...
MP_PUBLIC_KEY=TEST-...
MP_WEBHOOK_SECRET=
MP_SUCCESS_URL=http://localhost:5173/checkout/success
MP_FAILURE_URL=http://localhost:5173/checkout/failure
MP_PENDING_URL=http://localhost:5173/checkout/pending

# --- Pricing ---
PRICE_BASIC_MXN=49
PRICE_PREMIUM_MXN=99

# --- Auth ---
# CAMBIA en producción — usar `python -c "import secrets; print(secrets.token_hex(32))"`
JWT_SECRET=dev-only-change-in-production-9f8a3b2c1d4e5f6a
JWT_ALGORITHM=HS256
MAGIC_LINK_TTL_MINUTES=15
SESSION_TTL_DAYS=30
MAGIC_LINK_BASE_URL=http://localhost:5173/auth/verify

# --- Email (SMTP) ---
# En dev: deja SMTP_HOST vacío para que el link se imprima en stdout.
# En prod: SendGrid (smtp.sendgrid.net), Resend, Postmark, etc.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=hola@verificarro.mx
SMTP_FROM_NAME=Verificarro
